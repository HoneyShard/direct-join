{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Raptor Manager",
    "identifier": "fun.raptor.manager",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Raptor Manager",
                "width": 640,
                "minWidth": 640,
                "height": 400,
                "minHeight": 400,
                "maxWidth": 640,
                "maxHeight": 400,
                "resizable": false,
                "fullscreen": false,
                "hiddenTitle": true,
                "titleBarStyle": "Overlay",
                "trafficLightPosition": {
                    "x": 0,
                    "y": -10
                },
                "acceptFirstMouse": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["dmg", "app"],
        "icon": ["icons/icon.icns", "icons/icon.icns"],
        "macOS": {
            "entitlements": "./Entitlements.plist",
            "signingIdentity": "-",
            "minimumSystemVersion": "12.0"
        },
        "createUpdaterArtifacts": true,
        "resources": ["icons/macsploit.png"]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MjRBRUYxQzc4MTJEQjQKUldTMExZSEg4YTRrRlFxZ0lxZjErTXh4NU02VTN2SUU0bEtSWFlYR1hWN2t6QWMrTXpuRG14cGcK",
            "endpoints": [
                "https://github.com/HoneyShard/direct-join/releases/latest/download/latest.json"
            ]
        }
    }
}
